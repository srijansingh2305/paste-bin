generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paste {
  id           String    @id @default(cuid())
  content      String    @db.Text
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  maxViews     Int?
  currentViews Int       @default(0)

  @@index([createdAt])
  @@index([expiresAt])
}